<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ink" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <Button android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="48dp"
            android:backgroundTint="@color/surface" android:text="←   Kembali" android:textAllCaps="false" android:textColor="#F4F5EF" />
        <TextView android:id="@+id/detailType" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="45dp" android:textColor="@color/accent" android:textSize="12sp" android:letterSpacing="0.1" android:textStyle="bold" />
        <TextView android:id="@+id/detailName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="#F4F5EF" android:textSize="37sp" android:textStyle="bold" />
        <ImageView android:id="@+id/detailImage" android:layout_width="match_parent" android:layout_height="210dp"
            android:layout_marginTop="25dp" android:background="@drawable/card_background" android:contentDescription="Ilustrasi kendaraan pilihan" android:padding="34dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/detailDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:lineSpacingExtra="5dp" android:textColor="#CBD0C6" android:textSize="16sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:text="TENTANG KELAS INI" android:textColor="@color/muted" android:textSize="11sp" android:letterSpacing="0.1" android:textStyle="bold" />
        <TextView android:id="@+id/detailExtra" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:lineSpacingExtra="5dp" android:textColor="#F4F5EF" android:textSize="14sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="35dp"
            android:text="GARASIKITA   •   KENALI KENDARAAN, NIKMATI PERJALANAN" android:textColor="#687165" android:textSize="9sp" android:letterSpacing="0.06" />
    </LinearLayout>
</ScrollView>
