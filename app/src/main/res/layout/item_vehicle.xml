<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:background="@drawable/card_background" android:gravity="center_vertical" android:minHeight="100dp"
    android:orientation="horizontal" android:padding="14dp">
    <ImageView android:id="@+id/vehicleImage" android:layout_width="88dp" android:layout_height="64dp"
        android:contentDescription="Foto kendaraan" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/vehicleType" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing="0.1" android:textStyle="bold" />
        <TextView android:id="@+id/vehicleName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#F4F5EF" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/vehicleDescription" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↗" android:textColor="@color/accent" android:textSize="20sp" />
</LinearLayout>
