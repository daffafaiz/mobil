<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ink" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="24dp" android:paddingBottom="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="KATALOG KENDARAAN  /  01" android:textColor="@color/accent"
            android:textSize="11sp" android:letterSpacing="0.12" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Temukan\nkendaraanmu." android:textColor="#F4F5EF"
            android:textSize="35sp" android:lineSpacingExtra="-3dp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Dari supercar sampai motor impian." android:textColor="@color/muted" android:textSize="14sp" />
        <EditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="22dp" android:backgroundTint="#4C554A" android:hint="Cari merek atau model..."
            android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:singleLine="true" android:textColor="#F4F5EF" android:textColorHint="#899184" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:orientation="horizontal">
            <Button android:id="@+id/carsButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:backgroundTint="@color/accent" android:text="Mobil" android:textAllCaps="false" android:textColor="@color/ink" android:textStyle="bold" />
            <Button android:id="@+id/bikesButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1"
                android:backgroundTint="@color/surface" android:text="Motor" android:textAllCaps="false" android:textColor="#F4F5EF" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/sectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="25dp" android:text="PILIH KELAS MOBIL" android:textColor="@color/muted" android:textSize="11sp" android:letterSpacing="0.11" android:textStyle="bold" />
        <LinearLayout android:id="@+id/vehicleList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp" android:text="GARASIKITA   •   PILIHAN PARA PECINTA JALAN" android:textColor="#687165" android:textSize="9sp" android:letterSpacing="0.08" />
    </LinearLayout>
</ScrollView>
